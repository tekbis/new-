# Stripe keys — add these in Vercel Project Settings > Environment Variables
# Secret key: sk_test_ / sk_live_ from Developers → API keys.
# Restricted keys (rk_test_ / rk_live_) also work if Checkout Sessions is allowed.
# Publishable key: pk_test_ / pk_live_. Do not rename rk_ to sk_ — that makes the key invalid.

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Required to accept Stripe webhooks. Unsigned webhook posts are rejected.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal REST app credentials from developer.paypal.com
# Use sandbox first. Set PAYPAL_ENV=live with live credentials when ready.

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# Admin dashboard password for /admin.html
# Use a long private password. Do not commit the real value.

ADMIN_PASSWORD=change_this_to_a_long_secret
