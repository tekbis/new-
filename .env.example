# Stripe keys — add these in Vercel Project Settings > Environment Variables
# Use sk_test_ / pk_test_ first, then live keys when you are ready.
# Secret and publishable keys must be the same mode (both test or both live).

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional. Needed only if you add a Stripe webhook endpoint later.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal REST app credentials from developer.paypal.com
# Use sandbox first. Set PAYPAL_ENV=live with live credentials when ready.

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# Admin dashboard password for /admin.html
# Use a long private password. Do not commit the real value.

ADMIN_PASSWORD=asdf1234
